# Copy this file to .env for local development only.
# In production, set these values in your hosting provider's secret manager.
# Never commit a real .env file or real credentials.

PROJECT_NAME="AURA Platform API"
API_V1_PREFIX="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Comma-separated list. Used by the FastAPI CORS middleware.
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Local Docker Compose database settings.
POSTGRES_DB="<local-database-name>"
POSTGRES_USER="<local-database-user>"
POSTGRES_PASSWORD="<local-database-password>"
POSTGRES_HOST_PORT=5433

# SQLAlchemy database URL. Keep production values in secrets, not source control.
DATABASE_URL="postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>"

# Storage Configuration ("local_dev", "supabase_storage", or "aws_s3")
STORAGE_PROVIDER="supabase_storage"
PRIVATE_STORAGE_BUCKET="aura-submissions-staging"
APPROVED_STORAGE_BUCKET="aura-approved-artifacts"
LOCAL_STORAGE_ROOT="uploads"
DEV_AUTO_APPROVE_SUBMISSIONS=true

# Supabase Auth & Storage settings. Keep service role secret server-side only.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PROJECT_REF="<project-ref>"
SUPABASE_JWT_SECRET="<supabase-jwt-secret>"
SUPABASE_JWT_AUDIENCE="authenticated"
SUPABASE_JWT_ISSUER="https://<project-ref>.supabase.co/auth/v1"
# Optional. Defaults to SUPABASE_URL/auth/v1/.well-known/jwks.json.
SUPABASE_JWKS_URL=""
# Required for server-side uploads to Supabase Storage (Dashboard -> Project Settings -> API -> service_role).
SUPABASE_SERVICE_ROLE_KEY="<supabase-service-role-secret-key>"
SUPABASE_ANON_KEY="<supabase-anon-public-key>"
