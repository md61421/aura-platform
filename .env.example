# Copy this file to .env for local development only.
# In production, set these values in your hosting provider's secret manager.
# Never commit a real .env file or real credentials.

PROJECT_NAME="AURA Platform API"
API_V1_PREFIX="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Comma-separated list. Used by the FastAPI CORS middleware.
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Local Docker Compose database settings.
POSTGRES_DB="<local-database-name>"
POSTGRES_USER="<local-database-user>"
POSTGRES_PASSWORD="<local-database-password>"
POSTGRES_HOST_PORT=5433

# SQLAlchemy database URL. Keep production values in secrets, not source control.
DATABASE_URL="postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>"

STORAGE_PROVIDER="local_dev"
PRIVATE_STORAGE_BUCKET="<private-storage-bucket>"
APPROVED_STORAGE_BUCKET="<approved-storage-bucket>"
